# Docker .env file for local development
# Copy to .env and customize as needed

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# Environment
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# GPU Configuration
DEVICE=cuda:0

# Database
DATABASE_URL=postgresql://drl_user:drl_password@postgres:5432/drl_ppt_db
POSTGRES_USER=drl_user
POSTGRES_PASSWORD=drl_password
POSTGRES_DB=drl_ppt_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# LanceDB
LANCEDB_HOST=localhost
LANCEDB_PORT=8081

# Model Configuration
VISION_MODEL=colpali
VISION_MODEL_SIZE=base
REASONING_MODEL=mm-r5
REASONING_MODEL_SIZE=7b
VERIFICATION_MODEL=argos
VERIFICATION_MODEL_SIZE=base

# Feature Extraction
COLPALI_CONFIDENCE_THRESHOLD=0.7
IMAGEBIND_ALIGNMENT_THRESHOLD=0.85

# Reasoning
REASONING_CHAIN_LENGTH=5
REASONING_CONFIDENCE_THRESHOLD=0.8
REASONING_BEAM_SIZE=3

# Verification
HALLUCINATION_RISK_THRESHOLD=0.45
EVIDENCE_COVERAGE_THRESHOLD=0.88
MAX_VERIFICATION_BATCH_SIZE=32

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090

# Logging
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Timeout (ms)
API_TIMEOUT=30000
INFERENCE_TIMEOUT=60000
BATCH_TIMEOUT=120000
